# Mail Vault Environment Configuration
# Copy this file to .env and adjust the values for your setup

# Application Settings
NODE_ENV=production
PORT=3000

# Auth.js (NextAuth v5) Configuration
# AUTH_URL is optional; Auth.js auto-detects the request URL in most setups.
AUTH_URL=http://localhost:3000
# Preferred env var for Auth.js v5. NEXTAUTH_SECRET is still honored for
# backwards compatibility during the migration window.
AUTH_SECRET=your-secret-key-here-change-this-in-production
# NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production

# Database Configuration
DATABASE_URL=file:./data/database/main.db
DATA_DIR=./data/accounts

# Attachment Storage
ATTACHMENTS_DIR=./data/attachments

# Email Sync Configuration
SYNC_INTERVAL_MINUTES=30
MAX_SYNC_ERRORS=5

# Sync Service HTTP Endpoint (internal trigger API)
# Web container posts to SYNC_SERVICE_URL when a manual sync is requested.
# SYNC_TRIGGER_TOKEN is a shared secret checked by the sync service.
SYNC_SERVICE_URL=http://sync:3001
SYNC_TRIGGER_TOKEN=change-me-shared-secret-between-web-and-sync
SYNC_HTTP_HOST=0.0.0.0
SYNC_HTTP_PORT=3001

# Sync Performance Optimization
SYNC_BATCH_SIZE=5
SYNC_BATCH_DELAY=1000
SYNC_RECONNECT_DELAY=5000

# Logging
LOG_LEVEL=info

# Security (Optional)
# If you want to run behind a reverse proxy:
# NEXTAUTH_URL=https://yourdomain.com
# TRUST_PROXY=true 